(:name "fotodruck"
 :title "Fotodruck"
 :navigable t
 :aliases ("foto")
 :screen "

   Ein Foto vom Fotoautomaten auf Papier ausgeben.
"
 :dynamic-areas ((:name info :from (3 0) :to (5 79)))
 :fields ((:from (7 3) :len 10 :name lbl-id)
          (:from (7 14) :len 6 :name photo-id :write t :intense t :highlighting underscore)
          (:from (9 3) :len 10 :name lbl-printer)
          (:from (9 14) :len 1 :name printer-sel :write t :intense t :highlighting underscore)
          (:from (9 17) :len 50 :name pr1 :color green)
          (:from (10 17) :len 50 :name pr2 :color green)
          (:from (11 17) :len 50 :name pr3 :color green))
 :keys ((:enter "Weiter" :hidden t)
        (:pf3 "Zurück" :back t)))
